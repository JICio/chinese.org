<Item class="Script" referent="MantraServer">
<Properties>
<string name="Name">MantraServer</string>
<ProtectedString name="Source">
-- 金光神咒 · 服務端主邏輯
-- 玩家在地圖裡撿「整字」（金色）與「偏旁部件」（綠色），按咒文順序拼出金光神咒

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local MANTRA = {
	"天","地","玄","宗","万","气","本","根",
	"广","修","亿","劫","证","吾","神","通",
	"三","界","内","外","惟","道","独","尊",
	"体","有","金","光","覆","映","吾","身",
}

local DECOMP = {
	["地"] = {"土","也"}, ["根"] = {"木","艮"}, ["亿"] = {"亻","乙"},
	["劫"] = {"去","力"}, ["证"] = {"讠","正"}, ["神"] = {"礻","申"},
	["外"] = {"夕","卜"}, ["惟"] = {"忄","隹"}, ["独"] = {"犭","虫"},
	["体"] = {"亻","本"}, ["映"] = {"日","央"},
}

local update = Instance.new("RemoteEvent")
update.Name = "MantraUpdate"
update.Parent = ReplicatedStorage

local state = {}

local function sendState(player, note)
	local st = state[player]
	if not st then return end
	update:FireClient(player, {
		progress = st.progress,
		total = #MANTRA,
		nextChar = MANTRA[st.progress],
		parts = st.parts,
		note = note,
	})
end

local function setupPlayer(player)
	state[player] = { progress = 1, parts = {}, done = 0 }
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	stats.Parent = player
	local prog = Instance.new("IntValue")
	prog.Name = "进度"
	prog.Value = 0
	prog.Parent = stats
	local done = Instance.new("IntValue")
	done.Name = "神咒"
	done.Value = 0
	done.Parent = stats
	player.CharacterAdded:Connect(function()
		task.wait(1)
		sendState(player)
	end)
end

Players.PlayerAdded:Connect(setupPlayer)
for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
Players.PlayerRemoving:Connect(function(p) state[p] = nil end)

local function celebrate(player)
	local char = player.Character
	if not char then return end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 214, 90)
		light.Brightness = 5
		light.Range = 26
		light.Parent = hrp
		local sparkles = Instance.new("Sparkles")
		sparkles.SparkleColor = Color3.fromRGB(255, 214, 90)
		sparkles.Parent = hrp
		local ff = Instance.new("ForceField")
		ff.Parent = char
		task.delay(15, function()
			light:Destroy()
			sparkles:Destroy()
			ff:Destroy()
		end)
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then hum.WalkSpeed = 22 end
end

local function advance(player, note)
	local st = state[player]
	st.progress += 1
	st.parts = {}
	player.leaderstats["进度"].Value = st.progress - 1
	if st.progress &gt; #MANTRA then
		st.done += 1
		player.leaderstats["神咒"].Value = st.done
		st.progress = 1
		player.leaderstats["进度"].Value = 0
		celebrate(player)
		update:FireAllClients({ announce = player.DisplayName .. " 修成金光神咒！体有金光，覆映吾身！" })
		sendState(player, "金光神咒修成！金光护体 15 秒！")
	else
		sendState(player, note)
	end
end

local function collect(player, glyph)
	local st = state[player]
	if not st then return false end
	local target = MANTRA[st.progress]
	if glyph == target then
		advance(player, "收到「" .. glyph .. "」！")
		return true
	end
	local parts = DECOMP[target]
	if parts then
		for _, p in ipairs(parts) do
			if glyph == p and not st.parts[p] then
				st.parts[p] = true
				local all = true
				for _, q in ipairs(parts) do
					if not st.parts[q] then all = false end
				end
				if all then
					advance(player, parts[1] .. " + " .. parts[2] .. " 拼成「" .. target .. "」！")
				else
					sendState(player, "捡到部件「" .. p .. "」，还差一半！")
				end
				return true
			end
		end
	end
	return false
end

-- ═══ 拾取物 ═══
local pickups = {}

local function chooseSpawnGlyph()
	local options = {}
	for _, st in pairs(state) do
		local target = MANTRA[st.progress]
		table.insert(options, { glyph = target, isPart = false })
		local parts = DECOMP[target]
		if parts then
			for _, p in ipairs(parts) do
				if not st.parts[p] then
					table.insert(options, { glyph = p, isPart = true })
					table.insert(options, { glyph = p, isPart = true })
				end
			end
		end
	end
	if #options == 0 or math.random() &lt; 0.25 then
		return { glyph = MANTRA[math.random(#MANTRA)], isPart = false }
	end
	return options[math.random(#options)]
end

local function spawnPickup()
	local choice = chooseSpawnGlyph()
	local part = Instance.new("Part")
	part.Name = "Pickup_" .. choice.glyph
	part.Size = Vector3.new(4, 4, 1)
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 0.3
	part.Material = Enum.Material.Neon
	part.Color = choice.isPart and Color3.fromRGB(64, 140, 110) or Color3.fromRGB(160, 120, 40)
	part.CFrame = CFrame.new(math.random(-220, 220), 5, math.random(-220, 220))

	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, 92, 0, 92)
	gui.AlwaysOnTop = true
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = choice.glyph
	label.TextScaled = true
	label.Font = Enum.Font.SourceSansBold
	label.TextColor3 = choice.isPart and Color3.fromRGB(160, 255, 215) or Color3.fromRGB(255, 226, 140)
	label.TextStrokeTransparency = 0.35
	label.Parent = gui

	part.Touched:Connect(function(hit)
		local parent = hit.Parent
		if not parent then return end
		local player = Players:GetPlayerFromCharacter(parent)
		if not player then return end
		if collect(player, choice.glyph) then
			part:Destroy()
		end
	end)

	part.Parent = workspace
	table.insert(pickups, part)
end

RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for i = #pickups, 1, -1 do
		local p = pickups[i]
		if p.Parent == nil then
			table.remove(pickups, i)
		else
			p.CFrame = CFrame.new(p.Position.X, 5 + math.sin(t * 2 + i) * 1.2, p.Position.Z) * CFrame.Angles(0, t * 0.8 + i, 0)
		end
	end
end)

task.spawn(function()
	while true do
		if #pickups &lt; 45 then spawnPickup() end
		task.wait(0.6)
	end
end)
</ProtectedString>
</Properties>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBXSP">
<Properties><string name="Name">StarterPlayer</string></Properties>
<Item class="StarterPlayerScripts" referent="RBXSPS">
<Properties><string name="Name">StarterPlayerScripts</string></Properties>
<Item class="LocalScript" referent="MantraHUD">
<Properties>
<string name="Name">MantraHUD</string>
<ProtectedString name="Source">
-- 金光神咒 · 客戶端 HUD
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local update = ReplicatedStorage:WaitForChild("MantraUpdate")

local MANTRA_TEXT = "天地玄宗，万气本根。广修亿劫，证吾神通。三界内外，惟道独尊。体有金光，覆映吾身。"
local DECOMP = {
	["地"] = {"土","也"}, ["根"] = {"木","艮"}, ["亿"] = {"亻","乙"},
	["劫"] = {"去","力"}, ["证"] = {"讠","正"}, ["神"] = {"礻","申"},
	["外"] = {"夕","卜"}, ["惟"] = {"忄","隹"}, ["独"] = {"犭","虫"},
	["体"] = {"亻","本"}, ["映"] = {"日","央"},
}

local gui = Instance.new("ScreenGui")
gui.Name = "MantraHUD"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0.7, 0, 0, 110)
frame.Position = UDim2.new(0.15, 0, 0, 8)
frame.BackgroundColor3 = Color3.fromRGB(14, 14, 13)
frame.BackgroundTransparency = 0.2
frame.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 14)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 24)
title.BackgroundTransparency = 1
title.Text = "☯ 金光神咒 · 找齐字与部件，按顺序拼出神咒"
title.TextColor3 = Color3.fromRGB(195, 154, 84)
title.TextScaled = true
title.Font = Enum.Font.SourceSansBold
title.Parent = frame

local mantraLabel = Instance.new("TextLabel")
mantraLabel.Size = UDim2.new(1, -16, 0, 54)
mantraLabel.Position = UDim2.new(0, 8, 0, 26)
mantraLabel.BackgroundTransparency = 1
mantraLabel.RichText = true
mantraLabel.TextScaled = true
mantraLabel.Font = Enum.Font.SourceSansBold
mantraLabel.Text = ""
mantraLabel.Parent = frame

local hintLabel = Instance.new("TextLabel")
hintLabel.Size = UDim2.new(1, 0, 0, 26)
hintLabel.Position = UDim2.new(0, 0, 0, 82)
hintLabel.BackgroundTransparency = 1
hintLabel.TextColor3 = Color3.fromRGB(127, 216, 184)
hintLabel.TextScaled = true
hintLabel.Font = Enum.Font.SourceSansBold
hintLabel.Text = ""
hintLabel.Parent = frame

local noteLabel = Instance.new("TextLabel")
noteLabel.Size = UDim2.new(0.6, 0, 0, 34)
noteLabel.Position = UDim2.new(0.2, 0, 0.2, 0)
noteLabel.BackgroundTransparency = 1
noteLabel.TextColor3 = Color3.fromRGB(255, 214, 90)
noteLabel.TextScaled = true
noteLabel.Font = Enum.Font.SourceSansBold
noteLabel.TextStrokeTransparency = 0.3
noteLabel.Text = ""
noteLabel.Parent = gui

local noteToken = 0
local function showNote(text, seconds)
	noteToken += 1
	local my = noteToken
	noteLabel.Text = text
	task.delay(seconds or 2.5, function()
		if noteToken == my then noteLabel.Text = "" end
	end)
end

local function render(data)
	local rich = {}
	local n = 0
	for _, code in utf8.codes(MANTRA_TEXT) do
		local ch = utf8.char(code)
		if ch == "，" or ch == "。" then
			table.insert(rich, '&lt;font color="#666660"&gt;' .. ch .. '&lt;/font&gt;')
		else
			n += 1
			if n &lt; data.progress then
				table.insert(rich, '&lt;font color="#FFD65A"&gt;' .. ch .. '&lt;/font&gt;')
			elseif n == data.progress then
				table.insert(rich, '&lt;font color="#FF6B52"&gt;' .. ch .. '&lt;/font&gt;')
			else
				table.insert(rich, '&lt;font color="#555550"&gt;' .. ch .. '&lt;/font&gt;')
			end
		end
	end
	mantraLabel.Text = table.concat(rich)

	local target = data.nextChar
	if target then
		local parts = DECOMP[target]
		if parts then
			local have = {}
			for _, p in ipairs(parts) do
				if data.parts and data.parts[p] then
					table.insert(have, p .. "✓")
				else
					table.insert(have, p)
				end
			end
			hintLabel.Text = "下一个：" .. target .. "（可拼：" .. table.concat(have, " + ") .. "）"
		else
			hintLabel.Text = "下一个：" .. target
		end
	end
end

update.OnClientEvent:Connect(function(data)
	if data.announce then
		showNote(data.announce, 5)
		return
	end
	render(data)
	if data.note then showNote(data.note) end
end)
</ProtectedString>
</Properties>
</Item>
</Item>
